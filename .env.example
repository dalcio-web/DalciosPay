# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Firebase Config (Get from firebase-applet-config.json)
VITE_AUTH_PROVIDER="firebase"
# Fonte financeira ativa. Mantenha "mongodb" até validar a homologação MariaDB.
# Para o corte controlado na Hostinger, altere somente para "mariadb".
DATA_BACKEND="mongodb"
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID=""

# Firebase Admin (backend only; never expose these as VITE_* variables)
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
# Preserve the escaped newlines when configuring this value in Hostinger.
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# Supabase Config
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-key"
# Also supports the following if provided
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="your-publishable-key"

# MongoDB Config (Optional: configure to migrate and switch main syncer to MongoDB Atlas)
MONGODB_URI="mongodb+srv://username:password@cluster.mongodb.net/your-database-name?retryWrites=true&w=majority"

# MariaDB / Hostinger (backend only; never use the VITE_ prefix)
DB_HOST=""
DB_PORT="3306"
DB_USER=""
DB_PASSWORD=""
DB_NAME=""
DB_CONNECTION_LIMIT="5"
DB_SSL="false"

